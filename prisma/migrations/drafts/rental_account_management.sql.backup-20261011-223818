-- 2. TABLE: RentalAccount
-- ============================================================================
-- One row per rental account owned by a game. Example: game "CS2" may own
-- accounts CS2-01, CS2-02, CS2-03, each with its own status and rate.
--
-- Credential handling: NO password column exists here on purpose. Only
-- `secretRef` is stored, which is a pointer to an external secret manager
-- (e.g. "vault://dreamcafe/steam/cs2-01"). See src/lib/secret-manager.ts.

-- CreateTable
CREATE TABLE "RentalAccount" (
    "id"          TEXT NOT NULL,
    "accountCode" TEXT NOT NULL,
    "gameId"      TEXT NOT NULL,
    "status"      "RentalAccountStatus" NOT NULL DEFAULT 'AVAILABLE',
    "hourlyRate"  DOUBLE PRECISION NOT NULL DEFAULT 5000,
    "secretRef"   TEXT,
    "notes"       TEXT,
    "isActive"    BOOLEAN NOT NULL DEFAULT true,
    "createdAt"   TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "updatedAt"   TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT "RentalAccount_pkey" PRIMARY KEY ("id")
);

-- CreateIndex
-- Account codes are unique across the whole catalog (e.g. "CS2-01" cannot be
-- reused by another game), matching how PC.stationNumber and
-- Console.stationNumber are globally unique today.
CREATE UNIQUE INDEX "RentalAccount_accountCode_key" ON "RentalAccount"("accountCode");

-- CreateIndex
CREATE INDEX "RentalAccount_gameId_idx" ON "RentalAccount"("gameId");

-- CreateIndex
CREATE INDEX "RentalAccount_status_idx" ON "RentalAccount"("status");

-- CreateIndex
CREATE INDEX "RentalAccount_isActive_idx" ON "RentalAccount"("isActive");

-- CreateIndex
-- Composite index for the primary admin listing filter (accounts of a game
-- filtered by status), which is the hottest read path for this table.
CREATE INDEX "RentalAccount_gameId_status_idx" ON "RentalAccount"("gameId", "status");

-- AddForeignKey
-- ON DELETE RESTRICT: a Game that still has rental accounts cannot be deleted.
-- This protects rental history. Deleting a game would require deactivating
-- (isActive = false) its accounts first, which is an explicit staff action.
ALTER TABLE "RentalAccount"
    ADD CONSTRAINT "RentalAccount_gameId_fkey"
    FOREIGN KEY ("gameId") REFERENCES "Game"("id") ON DELETE RESTRICT ON UPDATE CASCADE;


