-- ============================================================================
-- 3a. CONCURRENCY GUARANTEE — THE MOST IMPORTANT CONSTRAINT IN THIS MIGRATION
-- ============================================================================
-- A partial unique index physically guarantees, at the database level, that one
-- rental account can never have two ACTIVE allocations at the same time.
--
-- This closes the double-rental race that application-level "check then insert"
-- logic cannot close: two concurrent requests can both read status = AVAILABLE,
-- but only one INSERT ... WHERE status = 'ACTIVE' can succeed against this
-- index. PostgreSQL enforces it atomically; the loser receives a unique
-- violation (Prisma P2002), which the service maps to a clear
-- "account already rented" business response instead of a 500.
CREATE UNIQUE INDEX "RentalAllocation_rentalAccountId_active_key"
    ON "RentalAllocation"("rentalAccountId")
    WHERE "status" = 'ACTIVE';

-- AddForeignKey
ALTER TABLE "RentalAllocation"
    ADD CONSTRAINT "RentalAllocation_rentalAccountId_fkey"
    FOREIGN KEY ("rentalAccountId") REFERENCES "RentalAccount"("id") ON DELETE RESTRICT ON UPDATE CASCADE;

-- AddForeignKey
-- ON DELETE RESTRICT: a Session that has rental history cannot be deleted.
ALTER TABLE "RentalAllocation"
    ADD CONSTRAINT "RentalAllocation_sessionId_fkey"
    FOREIGN KEY ("sessionId") REFERENCES "Session"("id") ON DELETE RESTRICT ON UPDATE CASCADE;


